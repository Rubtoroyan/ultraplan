# Copy to .env.local for local development. Never commit real values.

# Supabase (server-side only; service role bypasses RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel
ADMIN_PASSWORD=

# Encryption key for SSNs in credit applications
SSN_ENCRYPTION_KEY=

# /api/keepalive auth
# KEEPALIVE_SECRET: for external monitors (cron-job.org) via
#   `Authorization: Bearer <secret>` or `?key=<secret>`.
# CRON_SECRET: Vercel Cron sends `Authorization: Bearer <secret>` automatically.
# Generate each with: openssl rand -hex 32
KEEPALIVE_SECRET=
CRON_SECRET=
